# ==========================================================================
# narminhasanli — root .gitignore
# Hər alt-layihənin (server/, client-next/) öz .gitignore-u da var.
# ==========================================================================

# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.js

# ---------- Environment (real secretləri HEÇ VAXT commit etmə) ----------
.env
.env.*
!.env.example

# ---------- Build / output artefaktları ----------
dist/
dist-ssr/
build/
out/
.next/
.vercel/

# ---------- Server upload qovluğu ----------
uploads/

# ---------- Loglar ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Editor / IDE ----------
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# ---------- OS junk ----------
.DS_Store
Thumbs.db
Desktop.ini
